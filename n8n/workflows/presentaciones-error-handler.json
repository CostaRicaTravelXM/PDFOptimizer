        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'failed', step: 'Error en ' + $json.node, error: { message: $json.message, step: 'unknown' } }) }}",
        "options": {
          "timeout": 30000
        }
      },
