              "id": "e1cec9a3-a33f-4fcf-acde-afa21a047222",
              "leftValue": "={{ $json.found }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "1261d800-2014-485d-ad33-e2e330542703",
