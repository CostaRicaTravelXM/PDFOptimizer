# Cloudflare R2, for the Email Image Hosting tool. See the README for how to obtain these.
# Copy to .env.local for development; set the same values in Vercel for production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket, no trailing slash: https://pub-xxxx.r2.dev or a custom domain.
R2_PUBLIC_BASE_URL=https://pub-74736f1e56a2481ea45b09096c1cd920.r2.dev

# Optional. Only needed for a bucket created in a specific jurisdiction, where the S3 endpoint
# is https://<account>.eu.r2.cloudflarestorage.com rather than the default.
# R2_ENDPOINT=

# AI Itinerary Presentation. All server-only; none of these may carry a NEXT_PUBLIC_ prefix.
# Production webhook URL of the n8n workflow that plans and builds the deck.
N8N_PRESENTATION_WEBHOOK_URL=
# Sent to n8n as the `x-tools-secret` header so only this app can start a job.
N8N_SHARED_SECRET=
# n8n sends it back as `Authorization: Bearer …` when it updates a job or asks for a PPTX.
PRESENTATIONS_COMPILE_SECRET=
# Optional. When set, the presentation tool asks for this code once per browser before it
# will start a job — the cheapest way to keep strangers from spending Claude and Canva quota.
# TOOLS_ACCESS_CODE=
